{"version":3,"kind":"Notebook","sha256":"bf7875b10e8a55d74c66d2b85febcbe87de146278b85005cbb657b323d084e19","slug":"recipes.recipe02","location":"/recipes/recipe02.ipynb","dependencies":[],"frontmatter":{"title":"Recipe 2: Estimating Behavioral Response to Reform","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Policy Simulation Library","given":"Policy Simulation","family":"Library"},"name":"Policy Simulation Library","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/PSLmodels/Tax-Calculator","numbering":{"title":{"offset":2}},"source_url":"https://github.com/PSLmodels/Tax-Calculator/blob/main/docs/recipes/recipe02.ipynb","edit_url":"https://github.com/PSLmodels/Tax-Calculator/edit/main/docs/recipes/recipe02.ipynb","exports":[{"format":"ipynb","filename":"recipe02.ipynb","url":"/build/recipe02-ae3054f24b9e58ee737f31a72d0404f1.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"This is an advanced recipe that should be followed only after mastering the basic recipe.\nThis recipe shows how to analyze the behavioral responses to a tax reform using the Tax-Calculator behresp module.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eR4CF5ZUxS"}],"key":"dGjZf0LuP1"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The assumed elasticities below specify a substitution elasticity of taxable income of 0.25 and leave the income elasticity (","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zeh1yjC0Dd"},{"type":"inlineCode","value":"inc","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"GIUZ9ACS0T"},{"type":"text","value":") and the capital-gains semi-elasticity (","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"urP27LJhXS"},{"type":"inlineCode","value":"cg","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ISIaXhXWQO"},{"type":"text","value":") at their default value of zero, so only the substitution response channel is active.\nEach elasticity is documented on the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ZB1xafOK7H"},{"type":"link","url":"/guide/behavior-params","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"behavior parameters","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zM0WJDe27m"}],"urlSource":"../guide/behavior_params","dataUrl":"/guide.behavior-params.json","internal":true,"protocol":"file","key":"BhWr6EfBDv"},{"type":"text","value":" page.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"JEhQvsmSF2"}],"key":"borgTCW0o2"}],"key":"tiiARLvbnl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sys\nif 'google.colab' in sys.modules:\n    !pip install -q condacolab &> /dev/null # dev/null suppresses output\n    import condacolab\n    condacolab.install()","key":"AL3XzblqS1"},{"type":"outputs","id":"0jV53WaKEg_1rMY11PuuZ","children":[],"key":"qSpE8S6Wwp"}],"key":"JsRyNmV1E1"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Install taxcalc if not already installed\nif 'taxcalc' not in sys.modules:\n    %pip install taxcalc &> /dev/null # dev/null suppresses output\n","visibility":"show","key":"I0roYGTPYW"},{"type":"outputs","id":"o-NlQv4knKUj8EuXUBdkl","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Note: you may need to restart the kernel to use updated packages.\n"},"key":"eH4n3CMILC"}],"visibility":"show","key":"S7LX6814wj"}],"visibility":"remove","key":"flGWiDL0Bh"},{"type":"block","kind":"notebook-code","data":{"hide-output":false},"children":[{"type":"code","lang":"python","executable":true,"value":"import taxcalc as tc\n\n# use publicly-available CPS input file\nrecs = tc.Records.cps_constructor()\n\n# specify baseline Calculator object representing current-law policy\npol = tc.Policy()\ncalc1 = tc.Calculator(policy=pol, records=recs)\n\nCYR = 2020\n\n# calculate aggregate current-law income tax liabilities for cyr\ncalc1.advance_to_year(CYR)\ncalc1.calc_all()\nitax_rev1 = calc1.weighted_total('iitax')\n\n# specify Calculator object for static analysis of reform policy\npol.implement_reform(tc.Policy.read_json_reform('github://PSLmodels:Tax-Calculator@master/docs/recipes/_static/reformA.json'))\ncalc2 = tc.Calculator(policy=pol, records=recs)\n\n# calculate reform income tax liabilities for cyr under static assumptions\ncalc2.advance_to_year(CYR)\ncalc2.calc_all()\nitax_rev2sa = calc2.weighted_total('iitax')\n\n# specify assumed non-zero response-function substitution elasticity\n# (the omitted 'esf', 'inc' and 'cg' parameters are assumed to be zero)\nresponse_elasticities = {'sub': 0.25}\n\n# specify Calculator object for analysis of reform with behavioral responses\n# (the response function returns baseline and reform DataFrame objects and\n#  leaves calc1 and calc2 unchanged; the discarded first DataFrame contains\n#  the baseline results, which are the same as the calc1 results above)\ncalc2 = tc.Calculator(policy=pol, records=recs)\ncalc2.advance_to_year(CYR)\n_, df2br = tc.response(calc1, calc2, response_elasticities)\n\n# calculate reform income tax liabilities for CYR with behavioral response\n# (weighted_total cannot be used here because the response function returns\n#  a DataFrame rather than a Calculator object, so the weighting by the s006\n#  filing-unit sampling weight must be done explicitly)\nitax_rev2br = (df2br['iitax'] * df2br['s006']).sum()\n\n# print total income tax revenue estimates for CYR\n# (estimates in billons of dollars)\nprint('{}_CURRENT_LAW_P__itax_rev($B)= {:.3f}'.format(CYR, itax_rev1 * 1e-9))\nprint('{}_REFORM_STATIC__itax_rev($B)= {:.3f}'.format(CYR, itax_rev2sa * 1e-9))\nprint('{}_REFORM_DYNAMIC_itax_rev($B)= {:.3f}'.format(CYR, itax_rev2br * 1e-9))","key":"Ug5fRfSHKk"},{"type":"outputs","id":"2bR1Tcm_N-tCUfdxVnpf7","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2020_CURRENT_LAW_P__itax_rev($B)= 773.650\n2020_REFORM_STATIC__itax_rev($B)= 777.826\n2020_REFORM_DYNAMIC_itax_rev($B)= 765.546\n"},"key":"XBbpIL9EVC"}],"key":"xVep8VkAUh"}],"key":"e2dsescfbe"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create multi-year diagnostic tables for","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FX4QgK3N0x"}],"key":"IwVabX0phZ"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"baseline,","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xSdDKZdXZz"}],"key":"ZEy0bJoXmj"}],"key":"ccmH42E8aW"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"reform excluding behavioral responses, and","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"exDCjj1gfo"}],"key":"vzrVsuz4U9"}],"key":"SKoGC1JbDX"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"reform including behavioral responses","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"c3wXklBOVd"}],"key":"jjOelSjifV"}],"key":"LoRBSaKu87"}],"key":"Q3Px0mSa0E"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Each year in the loop below is analyzed independently: the response function is called once per year and no response computed in one year is carried over into another year.\nThis means that retiming behavior, most notably the realization timing of capital gains, is not being modeled.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Ve3jM98Wse"}],"key":"TKceRw7McZ"}],"key":"OBzuNTFYmt"},{"type":"block","kind":"notebook-code","data":{"hide-output":false},"children":[{"type":"code","lang":"python","executable":true,"value":"NUM_YEARS = 3  # number of diagnostic table years beginning with CYR\ndtable1 = calc1.diagnostic_table(NUM_YEARS)\ndtable2 = calc2.diagnostic_table(NUM_YEARS)\ndvar_list3 = list()\nyear_list3 = list()\nfor year in range(CYR, CYR + NUM_YEARS):\n    calc1.advance_to_year(year)\n    calc2.advance_to_year(year)\n    _, df2br = tc.response(calc1, calc2, response_elasticities)\n    dvar_list3.append(df2br)\n    year_list3.append(year)\ndtable3 = tc.create_diagnostic_table(dvar_list3, year_list3)","key":"f7jCwAYPzW"},{"type":"outputs","id":"njJo8a5NjcCQuX8pVYkrT","children":[],"key":"MdN9FMdzqR"}],"key":"H0PS8iMVAl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Diagnostic table for baseline:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qaLbWh0DWH"}],"key":"yi5vcK7Yta"}],"key":"WWVSpoHpjR"},{"type":"block","kind":"notebook-code","data":{"hide-output":false},"children":[{"type":"code",